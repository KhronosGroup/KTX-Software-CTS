{
    "description": "Test single-threaded encode with various BCn encoding parameter combinations (no RDO).",
    "command": "ktx encode --testrun --threads 1 ${select[args]} output/encode/bcn_params/output_${select[id]}.ktx2",
    "status": 0,
    "outputs": {
        "output/encode/bcn_params/output_${select[id]}.ktx2": "golden/encode/bcn_params/output_${select[id]}.ktx2"
    },
    "args": {
        "select": [
            { "id": "bc1_fastest",         "args": "--format BC1_RGB_SRGB_BLOCK --bcn-quality fastest input/ktx2/valid_R8G8B8_SRGB_2D.ktx2" },
            { "id": "bc1_faster",          "args": "--format BC1_RGB_SRGB_BLOCK --bcn-quality faster input/ktx2/valid_R8G8B8_SRGB_2D.ktx2" },
            { "id": "bc1_fast",            "args": "--format BC1_RGB_SRGB_BLOCK --bcn-quality fast input/ktx2/valid_R8G8B8_SRGB_2D.ktx2" },
            { "id": "bc1_medium",          "args": "--format BC1_RGB_SRGB_BLOCK --bcn-quality medium input/ktx2/valid_R8G8B8_SRGB_2D.ktx2" },
            { "id": "bc1_thorough",        "args": "--format BC1_RGB_SRGB_BLOCK --bcn-quality thorough input/ktx2/valid_R8G8B8_SRGB_2D.ktx2" },
            { "id": "bc1_exhaustive",      "args": "--format BC1_RGB_SRGB_BLOCK --bcn-quality exhaustive input/ktx2/valid_R8G8B8_SRGB_2D.ktx2" },
            { "id": "bc1_thorough_linear", "args": "--format BC1_RGB_UNORM_BLOCK --bcn-quality thorough input/ktx2/valid_R8G8B8_UNORM_2D.ktx2" },

            { "id": "bc3_fastest",         "args": "--format BC3_SRGB_BLOCK --bcn-quality fastest input/ktx2/valid_R8G8B8A8_SRGB_2D.ktx2" },
            { "id": "bc3_faster",          "args": "--format BC3_SRGB_BLOCK --bcn-quality faster input/ktx2/valid_R8G8B8A8_SRGB_2D.ktx2" },
            { "id": "bc3_fast",            "args": "--format BC3_SRGB_BLOCK --bcn-quality fast input/ktx2/valid_R8G8B8A8_SRGB_2D.ktx2" },
            { "id": "bc3_medium",          "args": "--format BC3_SRGB_BLOCK --bcn-quality medium input/ktx2/valid_R8G8B8A8_SRGB_2D.ktx2" },
            { "id": "bc3_thorough",        "args": "--format BC3_SRGB_BLOCK --bcn-quality thorough input/ktx2/valid_R8G8B8A8_SRGB_2D.ktx2" },
            { "id": "bc3_exhaustive",      "args": "--format BC3_SRGB_BLOCK --bcn-quality exhaustive input/ktx2/valid_R8G8B8A8_SRGB_2D.ktx2" },
            { "id": "bc3_thorough_linear", "args": "--format BC3_UNORM_BLOCK --bcn-quality thorough input/ktx2/valid_R8G8B8A8_UNORM_2D.ktx2" },

            { "id": "bc4",                 "args": "--format BC4_UNORM_BLOCK input/ktx2/valid_R8_UNORM_2D.ktx2" },
            { "id": "bc5",                 "args": "--format BC5_UNORM_BLOCK input/ktx2/valid_R8G8_UNORM_2D.ktx2" },

            { "id": "bc6hu",               "args": "--format BC6H_UFLOAT_BLOCK input/ktx2/valid_R16G16B16_SFLOAT_2D.ktx2" },

            { "id": "bc7_fastest",         "args": "--format BC7_SRGB_BLOCK --bcn-quality fastest input/ktx2/valid_R8G8B8A8_SRGB_2D.ktx2" },
            { "id": "bc7_faster",          "args": "--format BC7_SRGB_BLOCK --bcn-quality faster input/ktx2/valid_R8G8B8A8_SRGB_2D.ktx2" },
            { "id": "bc7_fast",            "args": "--format BC7_SRGB_BLOCK --bcn-quality fast input/ktx2/valid_R8G8B8A8_SRGB_2D.ktx2" },
            { "id": "bc7_medium",          "args": "--format BC7_SRGB_BLOCK --bcn-quality medium input/ktx2/valid_R8G8B8A8_SRGB_2D.ktx2" },
            { "id": "bc7_thorough",        "args": "--format BC7_SRGB_BLOCK --bcn-quality thorough input/ktx2/valid_R8G8B8A8_SRGB_2D.ktx2" },
            { "id": "bc7_exhaustive",      "args": "--format BC7_SRGB_BLOCK --bcn-quality exhaustive input/ktx2/valid_R8G8B8A8_SRGB_2D.ktx2" }
        ]
    }
}
